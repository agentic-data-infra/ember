# Velox and Axiom, built with CMake (see scripts/build_deps.sh) and wrapped as
# prebuilt libraries. Flags come from third-party/generated/deps.bzl, which
# scripts/gen_third_party.py derives from the CMake build.

load("//third-party:check_deps.bzl", "check_deps")
load(
    "//third-party/generated:deps.bzl",
    # Missing in files generated for GCC 11's folly: rerun
    # scripts/gen_third_party.py.
    "DEPS_PREFIX",
    "FBTHRIFT_LINKER_FLAGS",
    "LINKER_FLAGS",
    "PREPROCESSOR_FLAGS",
    "PYTHON_PREPROCESSOR_FLAGS",
    "TEST_LINKER_FLAGS",
)

check_deps(DEPS_PREFIX)

# Velox, Axiom and their system dependencies (folly, glog, boost, ...).
prebuilt_cxx_library(
    name = "velox_axiom",
    header_only = True,
    exported_preprocessor_flags = PREPROCESSOR_FLAGS,
    exported_post_linker_flags = LINKER_FLAGS,
    visibility = ["PUBLIC"],
)

# googletest/gmock plus the Velox and Axiom test utilities (e.g. the Velox
# exec PlanBuilder and AssertQueryBuilder).
prebuilt_cxx_library(
    name = "testing",
    header_only = True,
    exported_post_linker_flags = TEST_LINKER_FLAGS,
    exported_deps = [":velox_axiom"],
    visibility = ["PUBLIC"],
)

# fbthrift's C++ runtime: Ember's RPC (ember/rpc). The installed fbthrift is
# the one Velox's setup scripts build with the same folly, so it shares
# folly with Velox. Code generation: thrift_cpp_library in thrift.bzl.
prebuilt_cxx_library(
    name = "fbthrift",
    header_only = True,
    exported_post_linker_flags = FBTHRIFT_LINKER_FLAGS,
    exported_deps = [":velox_axiom"],
    visibility = ["PUBLIC"],
)

# Python and pybind11 headers for Ember's Python binding (python/), from the
# interpreter gen_third_party.py was given (default: ember/.venv).
prebuilt_cxx_library(
    name = "pybind11",
    header_only = True,
    exported_preprocessor_flags = PYTHON_PREPROCESSOR_FLAGS,
    visibility = ["PUBLIC"],
)
