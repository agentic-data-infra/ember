# Ember's user-facing Dataframe API. Headers are exported under "ember/", so
# programs include e.g. "ember/Session.h".

cxx_library(
    name = "api",
    srcs = glob(["*.cpp"]),
    header_namespace = "ember",
    exported_headers = glob(["*.h"]),
    exported_deps = ["//ember/driver:driver"],
    visibility = ["PUBLIC"],
)
