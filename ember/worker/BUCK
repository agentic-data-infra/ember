    name = "worker",
    srcs = glob(["*.cpp"]),
    header_namespace = "ember/worker",
    exported_headers = glob(["*.h"]),
    exported_deps = [
        "//ember/common:common",
        "//ember/rpc:rpc",
    ],
    visibility = ["PUBLIC"],
)
